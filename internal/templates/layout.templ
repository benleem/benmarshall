package templates

templ Layout(contents templ.Component, title string) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		<body hx-boost="true" hx-target="main">
			<main>
				@contents
			</main>
		</body>
	</html>
}

templ head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0"
		/>
		<title>{ title }</title>
		// <title hx-swap-oob="true">{ title }</title>
		<link rel="icon" type="image/png" href="/static/assets/cyberslug-nobg.png"/>
		<link rel="stylesheet" href="/static/styles/reset.css"/>
		<link rel="stylesheet" href="/static/styles/monospace-web.css"/>
		// <script src="/static/scripts/htmx.min.js"></script>
		<script defer src="/static/scripts/components.js"></script>
	</head>
}
