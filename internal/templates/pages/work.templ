package pages

templ Work(swapTitle bool, id string, work WorkInfo) {
	if swapTitle {
		<title>benmarshall - { work.Name }</title>
	}
	<div
		class="mx-auto max-w-7xl"
	>
		<h1
			class="pt-2 text-5xl font-semibold italic font-sans tracking-wider text-primary-orange"
		>
			{ work.Name }
		</h1>
	</div>
}
