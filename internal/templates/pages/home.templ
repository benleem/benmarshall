package pages

import "github.com/benleem/benmarshall/internal/templates/components"

templ Home(skills components.Skills, skillKeys []string, projects components.Projects, projectKeys []string) {
	<h1>benmarshall</h1>
	<div>
		<p>software developer specializing in web technologies</p>
		<a href="https://www.linkedin.com/in/benjamin-marshall-609906196/" target="_blank" rel="noopener noreferrer">linkedin</a>
		<a href="https://github.com/benleem" target="_blank" rel="noopener noreferrer">github</a>
	</div>
	@components.SkillsSection(skills, skillKeys)
	@components.ProjectTables(projects, projectKeys)
	<hr/>
	@components.Contact()
}
